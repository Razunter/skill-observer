#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "Stage or set aside all changes before verification; the hook checks index-equivalent files." >&2
    exit 1
fi
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
# Native OMP checks stay explicit-only: SKILL_OBSERVER_NATIVE_TESTS=1 bun run test
export SKILL_OBSERVER_NATIVE_TESTS=0
exec bun run check
