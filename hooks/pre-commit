#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
# Checks the staged tree in a temp export, so unstaged edits and untracked files neither block the commit nor leak into the check.
staged=$(mktemp -d -t precommit-XXXXXX)
trap 'rm -rf "$staged"' EXIT
git checkout-index -a --prefix="$staged/"
ln -s "$PWD/node_modules" "$staged/node_modules"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
# Native OMP checks stay explicit-only: SKILL_OBSERVER_NATIVE_TESTS=1 bun run test
export SKILL_OBSERVER_NATIVE_TESTS=0
cd "$staged"
bun run check
